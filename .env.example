# Copy to .env and fill in only the provider you select.
# The demo runs with no keys when RAG_LLM_PROVIDER=fake.

RAG_LLM_PROVIDER=fake
RAG_LLM_MODEL=
RAG_AUTO_INGEST=false

RAG_OPENAI_API_KEY=
RAG_ANTHROPIC_API_KEY=
RAG_GEMINI_API_KEY=
RAG_MISTRAL_API_KEY=
RAG_DEEPSEEK_API_KEY=


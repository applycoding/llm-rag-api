# Defaults run the demo with no API keys.
RAG_LLM_PROVIDER=fake
RAG_EMBEDDING_PROVIDER=local
RAG_CHROMA_PERSIST_DIR=./data/chroma
RAG_CHROMA_COLLECTION=documents

# Use the Chroma server from docker-compose instead of the embedded store.
# RAG_CHROMA_HOST=chroma
# RAG_CHROMA_PORT=8000

# Optional model override. Defaults are starting points, not a promise that a
# vendor still serves that exact name.
# RAG_LLM_MODEL=gpt-4o-mini

# RAG_LLM_PROVIDER=openai
# RAG_OPENAI_API_KEY=
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# RAG_LLM_PROVIDER=anthropic
# RAG_ANTHROPIC_API_KEY=
# RAG_ANTHROPIC_BASE_URL=https://api.anthropic.com

# RAG_LLM_PROVIDER=gemini
# RAG_GEMINI_API_KEY=
# RAG_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# RAG_LLM_PROVIDER=mistral
# RAG_MISTRAL_API_KEY=
# RAG_MISTRAL_BASE_URL=https://api.mistral.ai/v1

# RAG_LLM_PROVIDER=deepseek
# RAG_DEEPSEEK_API_KEY=
# RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com

# RAG_LLM_PROVIDER=ollama
# RAG_LLM_MODEL=llama3.1
# RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
